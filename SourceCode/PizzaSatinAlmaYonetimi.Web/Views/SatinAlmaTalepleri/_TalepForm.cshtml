@model TalepFormModel
@{var duzenleme=(bool)(ViewData["Duzenleme"]??false);var birimler=new[]{"Kg","Adet","Litre"};}
<div class="panel-icerik">@if(duzenleme){<input type="hidden" name="TalepId" value="@Model.TalepId"/><input type="hidden" name="TalepNo" value="@Model.TalepNo"/>}<label>Ürün Adı<input name="UrunAdi" value="@Model.UrunAdi" maxlength="150" required placeholder="Ürün adı giriniz"/></label><label>Ürün Açıklaması <small>İsteğe bağlı</small><textarea name="Aciklama" maxlength="255" placeholder="Ürün açıklaması giriniz">@Model.Aciklama</textarea></label><label>Miktar<input name="Miktar" value="@(Model.Miktar==0?null:Model.Miktar.ToString(System.Globalization.CultureInfo.InvariantCulture))" type="number" min="0.01" step="0.01" required placeholder="Miktar giriniz"/></label><label>Birim<select name="Birim" required><option value="">Birim seçiniz</option>@foreach(var b in birimler){<option value="@b" selected="@(Model.Birim==b)">@b</option>}</select></label></div>
