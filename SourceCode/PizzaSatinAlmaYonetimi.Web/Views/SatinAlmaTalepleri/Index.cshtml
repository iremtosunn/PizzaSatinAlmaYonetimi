@model SatinAlmaTalepleriViewModel
@{ViewData["Title"]="Satın Alma Talepleri";var satinAlmaEkibi=User.IsInRole("Satın Alma Yöneticisi")||User.IsInRole("Satın Alma Uzmanı");var yonetici=User.IsInRole("Satın Alma Yöneticisi");}
<link rel="stylesheet" href="~/css/yonetim.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/talepler.css" asp-append-version="true"/>
<div class="yonetim-ust"><form method="get" class="hizli-arama"><input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Talep ara..."/><button>⌕</button></form><button class="ikincil-dugme" type="button" data-ac="filtre">▽ Filtrele</button><button class="ana-dugme" type="button" data-ac="ekle">＋ Yeni Talep</button></div>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<section class="tablo-karti"><h2>Satın Alma Talep Listesi</h2><div class="tablo-sarma"><table><thead><tr><th>Talep No</th><th>Ürün Adı</th><th>Miktar</th><th>Birim</th><th>Talep Eden</th><th>Talep Tarihi</th><th>Açıklama</th><th>Durum</th>@if(yonetici){<th>İşlemler</th>}</tr></thead><tbody>@foreach(var t in Model.Talepler){<tr><td>@if(satinAlmaEkibi||t.TalepEdenKullaniciId==Model.GirisYapanKullaniciId){<a class="talep-link" asp-action="Index" asp-route-panel="duzenle" asp-route-duzenleNo="@t.TalepNo">@t.TalepNo</a>}else{@t.TalepNo}</td><td>@t.UrunAdi</td><td>@t.Miktar.ToString("N2")</td><td>@t.Birim</td><td>@t.TalepEden</td><td>@t.TalepTarihi.ToString("dd.MM.yyyy")</td><td class="aciklama">@(t.Aciklama??"—")</td><td><span class="talep-durum @DurumSinifi(t.Durum)">@t.Durum</span></td>@if(yonetici){<td>@if(t.Durum=="Reddedildi"){<form asp-action="GeriAl" method="post" onsubmit="return confirm('Talebi geri almak istediğinize emin misiniz?');"><input type="hidden" name="talepNo" value="@t.TalepNo"/><button>Geri Al</button></form>}else{<form asp-action="Reddet" method="post" onsubmit="return confirm('Bu talebi reddetmek istediğinize emin misiniz?');"><input type="hidden" name="talepNo" value="@t.TalepNo"/><button class="reddet">Talebi Reddet</button></form>}</td>}</tr>}@if(Model.Talepler.Count==0){<tr><td colspan="@(yonetici?9:8)" class="bos">Kriterlere uygun talep bulunamadı.</td></tr>}</tbody></table></div><p class="kayit-sayisi">@Model.Talepler.Count talep</p></section>
<dialog id="filtre" class="filtre-panel"><form method="get"><header><h2>Talepleri Filtrele</h2><button type="button" data-kapat>×</button></header><label>Arama<input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Talep No veya Ürün Adı"/></label><label>Talep Eden<input name="TalepEden" value="@Model.Filtre.TalepEden" placeholder="Ad Soyad"/></label><label>Durum<select name="Durumlar"><option value="">Durum seçiniz</option><option value="0" selected="@(Model.Filtre.Durumlar=="0")">İnceleniyor</option><option value="1" selected="@(Model.Filtre.Durumlar=="1")">Teklifler Alındı</option><option value="2" selected="@(Model.Filtre.Durumlar=="2")">Onaylandı</option><option value="3" selected="@(Model.Filtre.Durumlar=="3")">Reddedildi</option></select></label><div class="iki-sutun"><label>Başlangıç Tarihi<input type="date" name="BaslangicTarihi" value="@Model.Filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")"/></label><label>Bitiş Tarihi<input type="date" name="BitisTarihi" value="@Model.Filtre.BitisTarihi?.ToString("yyyy-MM-dd")"/></label></div><footer><a asp-action="Index" class="ikincil-dugme">Temizle</a><button class="ana-dugme">Filtrele</button></footer></form></dialog>
<dialog id="ekle" class="yan-panel"><form asp-action="Ekle" method="post"><header><h2>Yeni Satın Alma Talebi</h2><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div>@await Html.PartialAsync("_TalepForm",Model.Form,new ViewDataDictionary(ViewData){["Duzenleme"]=false})<footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Talebi Kaydet</button></footer></form></dialog>
<dialog id="duzenle" class="yan-panel"><form asp-action="Guncelle" method="post"><header><div><h2>Talebi Düzenle</h2><small>Talep No: @Model.Form.TalepNo</small></div><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div>@await Html.PartialAsync("_TalepForm",Model.Form,new ViewDataDictionary(ViewData){["Duzenleme"]=true})<footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Değişiklikleri Kaydet</button></footer></form></dialog>
@section Scripts{<script src="~/js/yonetim.js" asp-append-version="true"></script><script>yonetimBaslat('@Model.AcikPanel');</script>}
@functions{string DurumSinifi(string durum)=>durum switch{"Onaylandı"=>"onaylandi","Reddedildi"=>"reddedildi","Teklifler Alındı"=>"teklif-alindi",_=>"inceleniyor"};}
