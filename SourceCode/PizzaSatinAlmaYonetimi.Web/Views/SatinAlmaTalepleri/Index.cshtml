@model SatinAlmaTalepleriViewModel
@{ViewData["Title"]="Satın Alma Talepleri";var yonetici=Model.GirisYapanRolId==1;var uzman=Model.GirisYapanRolId==2;var satinAlmaEkibi=yonetici||uzman;}
<link rel="stylesheet" href="~/css/yonetim.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/talepler.css" asp-append-version="true"/>
<div class="yonetim-ust"><form method="get" class="hizli-arama"><input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Talep ara..."/><button>⌕</button></form><button class="ikincil-dugme" type="button" data-ac="filtre">▽ Filtrele</button><button class="ana-dugme" type="button" data-ac="ekle">＋ Yeni Talep</button></div>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<section class="tablo-karti"><h2>Satın Alma Talep Listesi</h2><div class="tablo-sarma"><table><thead><tr><th>Talep No</th><th>Ürün Adı</th><th>Miktar</th><th>Birim</th><th>Talep Eden</th><th>Talep Tarihi</th><th>Açıklama</th><th>Durum</th>@if(yonetici||uzman){<th>İşlemler</th>}</tr></thead><tbody>@foreach(var t in Model.Talepler){<tr><td>@if(satinAlmaEkibi||t.TalepEdenKullaniciId==Model.GirisYapanKullaniciId){<a class="talep-link" asp-action="Index" asp-route-panel="duzenle" asp-route-duzenleNo="@t.TalepNo">@t.TalepNo</a>}else{@t.TalepNo}</td><td>@t.UrunAdi</td><td>@t.Miktar.ToString("N2")</td><td>@t.Birim</td><td>@t.TalepEden</td><td>@t.TalepTarihi.ToString("dd.MM.yyyy")</td><td class="aciklama">@(t.Aciklama??"—")</td><td><span class="talep-durum @DurumSinifi(t.TalepDurumId)">@t.Durum</span></td>@if(yonetici||uzman){<td class="talep-islemleri">@if(uzman&&t.TalepDurumId==0){<a class="incele" asp-action="Index" asp-route-panel="incele" asp-route-inceleNo="@t.TalepNo">İncele</a>}@if(yonetici){if(t.TalepDurumId==3){<form asp-action="GeriAl" method="post"><input type="hidden" name="talepNo" value="@t.TalepNo"/><button>Geri Al</button></form>}else{<form asp-action="Reddet" method="post"><input type="hidden" name="talepNo" value="@t.TalepNo"/><button class="reddet">Talebi Reddet</button></form>}}</td>}</tr>}@if(Model.Talepler.Count==0){<tr><td colspan="@(yonetici||uzman?9:8)" class="bos">Kriterlere uygun talep bulunamadı.</td></tr>}</tbody></table></div><p class="kayit-sayisi">@Model.Talepler.Count talep</p></section>
<dialog id="filtre" class="filtre-panel"><form method="get"><header><h2>Talepleri Filtrele</h2><button type="button" data-kapat>×</button></header><label>Arama<input name="AramaMetni" value="@Model.Filtre.AramaMetni"/></label><label>Talep Eden<input name="TalepEden" value="@Model.Filtre.TalepEden"/></label><label>Durum<select name="Durumlar"><option value="">Durum seçiniz</option><option value="0" selected="@(Model.Filtre.Durumlar=="0")">İnceleniyor</option><option value="1" selected="@(Model.Filtre.Durumlar=="1")">Teklifler Alındı</option><option value="2" selected="@(Model.Filtre.Durumlar=="2")">Onaylandı</option><option value="3" selected="@(Model.Filtre.Durumlar=="3")">Reddedildi</option></select></label><div class="iki-sutun"><label>Başlangıç Tarihi<input type="date" name="BaslangicTarihi" value="@Model.Filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")"/></label><label>Bitiş Tarihi<input type="date" name="BitisTarihi" value="@Model.Filtre.BitisTarihi?.ToString("yyyy-MM-dd")"/></label></div><footer><a asp-action="Index" class="ikincil-dugme">Temizle</a><button class="ana-dugme">Filtrele</button></footer></form></dialog>
<dialog id="ekle" class="yan-panel"><form asp-action="Ekle" method="post"><header><h2>Yeni Satın Alma Talebi</h2><button type="button" data-kapat>×</button></header>@await Html.PartialAsync("_TalepForm",Model.Form,new ViewDataDictionary(ViewData){["Duzenleme"]=false})<footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Talebi Kaydet</button></footer></form></dialog>
<dialog id="duzenle" class="yan-panel"><form asp-action="Guncelle" method="post"><header><div><h2>Talebi Düzenle</h2><small>Talep No: @Model.Form.TalepNo</small></div><button type="button" data-kapat>×</button></header>@await Html.PartialAsync("_TalepForm",Model.Form,new ViewDataDictionary(ViewData){["Duzenleme"]=true})<footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Değişiklikleri Kaydet</button></footer></form></dialog>
@if(Model.IncelenecekTalep is { } talep){<dialog id="incele" class="yan-panel inceleme-panel"><form asp-action="Incele" method="post"><header><div><h2>Talebi İncele</h2><small>@talep.TalepNo numaralı talep</small></div><button type="button" data-kapat>×</button></header><div class="panel-icerik"><input asp-for="Inceleme.TalepId" name="TalepId" type="hidden"/><section class="talep-ozeti"><h3>Talep Bilgileri</h3><dl><dt>Talep No</dt><dd>@talep.TalepNo</dd><dt>Ürün Adı</dt><dd>@talep.UrunAdi</dd><dt>Talep Edilen Miktar</dt><dd>@talep.Miktar.ToString("N2") @talep.Birim</dd><dt>Talep Eden</dt><dd>@talep.TalepEden</dd><dt>Talep Tarihi</dt><dd>@talep.TalepTarihi?.ToString("dd.MM.yyyy")</dd><dt>Açıklama</dt><dd>@(talep.Aciklama??"—")</dd></dl></section><h3>Uzman Değerlendirmesi</h3><label>Depodaki Mevcut Miktar <span class="birimli-input"><input name="MevcutStokMiktari" type="number" min="0" step="0.01" required/><b>@talep.Birim</b></span></label><label>Stokun Tahmini Yeterlilik Süresi <span class="birimli-input"><input name="StokYeterlilikSuresiGun" type="number" min="0" required/><b>gün</b></span></label><fieldset><legend>Ertelenebilir mi?</legend><label><input type="radio" name="ErtelenebilirMi" value="false" required/> Hayır</label><label><input type="radio" name="ErtelenebilirMi" value="true"/> Evet</label></fieldset><p class="uzman-gorusu">Uzman Görüşü: <strong id="uzmanGorusu">Değerlendirilmedi</strong></p></div><footer><button type="button" class="ikincil-dugme" data-kapat>Vazgeç</button><button class="ana-dugme">Kaydet ve Teklif Sürecine Al</button></footer></form></dialog>}
@section Scripts{<script src="~/js/yonetim.js" asp-append-version="true"></script><script>yonetimBaslat('@Model.AcikPanel');document.querySelectorAll('input[name="ErtelenebilirMi"]').forEach(x=>x.addEventListener('change',()=>document.getElementById('uzmanGorusu').textContent=x.value==='true'?'Ertelenebilir':'Öncelikli'));</script>}
@functions{string DurumSinifi(int durum)=>durum switch{2=>"onaylandi",3=>"reddedildi",1=>"teklif-alindi",_=>"inceleniyor"};}
