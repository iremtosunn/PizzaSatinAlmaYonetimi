@model KullaniciYonetimiViewModel
@{ ViewData["Title"]="Kullanıcı Yönetimi"; }
<link rel="stylesheet" href="~/css/yonetim.css" asp-append-version="true" />
<div class="yonetim-ust">
  <form method="get" class="hizli-arama"><input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Kullanıcı ara..." aria-label="Kullanıcı ara"/><button>⌕</button></form>
  <button class="ikincil-dugme" type="button" data-ac="filtre">▽ Filtrele</button><button class="ana-dugme" type="button" data-ac="ekle">＋ Yeni Kullanıcı</button>
</div>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>} @if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<section class="ozetler">
 <article><span>♙</span><div><small>Toplam Kullanıcı</small><strong>@Model.Ozet.ToplamKullanici</strong></div></article><article><span>♙</span><div><small>Aktif Kullanıcı</small><strong>@Model.Ozet.AktifKullanici</strong></div></article><article><span>♙</span><div><small>Pasif Kullanıcı</small><strong>@Model.Ozet.PasifKullanici</strong></div></article><article><span>♢</span><div><small>Toplam Rol</small><strong>@Model.Ozet.ToplamRol</strong></div></article>
</section>
<section class="tablo-karti"><h2>Kullanıcı Listesi</h2><div class="tablo-sarma"><table><thead><tr><th>Kullanıcı ID</th><th>Ad Soyad</th><th>Kullanıcı Adı</th><th>E-posta</th><th>Rol</th><th>Durum</th><th>Son Giriş Tarihi</th><th>Kayıt Tarihi</th><th>İşlemler</th></tr></thead><tbody>
@foreach(var k in Model.Kullanicilar){<tr><td>@k.KullaniciId</td><td>@k.AdSoyad</td><td>@k.KullaniciAdi</td><td>@k.Eposta</td><td>@k.RolAdi</td><td><span class="durum @(k.Durum=="Aktif"?"aktif":"pasif")">@k.Durum</span></td><td>@(k.SonGirisTarihi?.ToString("dd.MM.yyyy")??"—")</td><td>@k.KayitTarihi.ToString("dd.MM.yyyy")</td><td class="islemler"><a title="Düzenle" asp-action="Index" asp-route-panel="duzenle" asp-route-duzenleId="@k.KullaniciId">✎</a><form asp-action="DurumGuncelle" method="post"><input type="hidden" name="kullaniciId" value="@k.KullaniciId"/><input type="hidden" name="yeniDurum" value="@(k.Durum=="Aktif"?0:1)"/><button title="@(k.Durum=="Aktif"?"Pasif yap":"Aktif yap")">⏻</button></form></td></tr>}
@if(Model.Kullanicilar.Count==0){<tr><td colspan="9" class="bos">Kriterlere uygun kullanıcı bulunamadı.</td></tr>}
</tbody></table></div><p class="kayit-sayisi">@Model.Kullanicilar.Count kullanıcı</p></section>

<dialog id="filtre" class="filtre-panel"><form method="get"><header><h2>Kullanıcıları Filtrele</h2><button type="button" data-kapat>×</button></header><label>Arama<input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Ad Soyad, Kullanıcı Adı veya E-posta"/></label><label>Rol<select name="RolAdi"><option value="">Rol seçiniz</option>@foreach(var r in Model.Roller){<option value="@r.RolAdi" selected="@(r.RolAdi==Model.Filtre.RolAdi)">@r.RolAdi</option>}</select></label><label>Durum<select name="Durum"><option value="">Durum seçiniz</option><option value="1" selected="@(Model.Filtre.Durum==1)">Aktif</option><option value="0" selected="@(Model.Filtre.Durum==0)">Pasif</option></select></label><div class="iki-sutun"><label>Başlangıç Tarihi<input type="date" name="BaslangicTarihi" value="@Model.Filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")"/></label><label>Bitiş Tarihi<input type="date" name="BitisTarihi" value="@Model.Filtre.BitisTarihi?.ToString("yyyy-MM-dd")"/></label></div><footer><a asp-action="Index" class="ikincil-dugme">Temizle</a><button class="ana-dugme">Filtrele</button></footer></form></dialog>

<dialog id="ekle" class="yan-panel"><form asp-action="Ekle" method="post"><header><h2>Yeni Kullanıcı</h2><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div>@await Html.PartialAsync("_KullaniciForm",Model.Form,new ViewDataDictionary(ViewData){["Duzenleme"]=false,["Roller"]=Model.Roller})<footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Kullanıcıyı Kaydet</button></footer></form></dialog>
<dialog id="duzenle" class="yan-panel"><form asp-action="Guncelle" method="post"><header><h2>Kullanıcıyı Düzenle</h2><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div>@await Html.PartialAsync("_KullaniciForm",Model.Form,new ViewDataDictionary(ViewData){["Duzenleme"]=true,["Roller"]=Model.Roller})<footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Değişiklikleri Kaydet</button></footer></form></dialog>
@section Scripts{<script src="~/js/yonetim.js" asp-append-version="true"></script><script>yonetimBaslat('@Model.AcikPanel');</script>}
