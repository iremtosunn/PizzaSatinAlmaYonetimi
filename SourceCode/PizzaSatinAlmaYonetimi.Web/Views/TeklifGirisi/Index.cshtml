@model TeklifGirisiViewModel
@{ViewData["Title"]="Teklif Girişi";}
<link rel="stylesheet" href="~/css/yonetim.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/teklifler.css" asp-append-version="true"/>
<div class="yonetim-ust"><form method="get" class="hizli-arama"><input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Teklif ara..."/><button>⌕</button></form><button class="ikincil-dugme" type="button" data-ac="filtre">▽ Filtrele</button><button class="ana-dugme" type="button" data-ac="ekle">＋ Yeni Teklif</button></div>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<section class="tablo-karti"><h2>Girilen Teklifler</h2><div class="tablo-sarma"><table><thead><tr><th>Teklif No</th><th>Talep No</th><th>Ürün Adı</th><th>Açıklama</th><th>Firma Adı</th><th>Birim Fiyat</th><th>Teklif Tutarı</th><th>Para Birimi</th><th>Teslim Süresi</th><th>SKT</th><th>Teklif Tarihi</th><th>Geçerlilik Tarihi</th><th>İşlemler</th></tr></thead><tbody>@foreach(var t in Model.Teklifler){<tr><td>@t.TeklifNo</td><td>@t.TalepNo</td><td>@t.UrunAdi</td><td class="aciklama">@(t.Aciklama??"—")</td><td>@t.FirmaAdi</td><td>@(t.BirimFiyat?.ToString("N2")??"—")</td><td>@t.TeklifTutari.ToString("N2")</td><td>@t.ParaBirimi</td><td>@t.TeslimSuresiGun gün</td><td>@(t.Skt?.ToString("dd.MM.yyyy")??"—")</td><td>@t.TeklifTarihi.ToString("dd.MM.yyyy")</td><td>@(t.GecerlilikTarihi?.ToString("dd.MM.yyyy")??"—")</td><td class="islemler">@if(t.Durum=="Girildi"){<a asp-action="Index" asp-route-panel="duzenle" asp-route-duzenleNo="@t.TeklifNo" title="Düzenle">✎</a><form asp-action="Sil" method="post" onsubmit="return confirm('Bu teklifi silmek istediğinize emin misiniz?');"><input type="hidden" name="teklifId" value="@t.TeklifId"/><button class="sil" title="Sil">⌫</button></form>}</td></tr>}@if(Model.Teklifler.Count==0){<tr><td colspan="13" class="bos">Kriterlere uygun teklif bulunamadı.</td></tr>}</tbody></table></div><p class="kayit-sayisi">@Model.Teklifler.Count teklif</p></section>
<dialog id="filtre" class="filtre-panel"><form method="get"><header><h2>Teklifleri Filtrele</h2><button type="button" data-kapat>×</button></header><label>Teklif, Talep veya Ürün<input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Teklif no, talep no veya ürün adı"/></label><div class="iki-sutun"><label>Tedarikçi<input name="FirmaAdi" value="@Model.Filtre.FirmaAdi" placeholder="Firma adı"/></label><label>Durum<select name="Durumlar"><option value="">Durum seçiniz</option><option value="0" selected="@(Model.Filtre.Durumlar=="0")">Girildi</option><option value="1" selected="@(Model.Filtre.Durumlar=="1")">Seçildi</option><option value="2" selected="@(Model.Filtre.Durumlar=="2")">Reddedildi</option></select></label></div><div class="iki-sutun"><label>Başlangıç Tarihi<input type="date" name="BaslangicTarihi" value="@Model.Filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")"/></label><label>Bitiş Tarihi<input type="date" name="BitisTarihi" value="@Model.Filtre.BitisTarihi?.ToString("yyyy-MM-dd")"/></label></div><div class="iki-sutun"><label>Minimum Tutar<input type="number" step="0.01" min="0" name="MinTutar" value="@Model.Filtre.MinTutar"/></label><label>Maksimum Tutar<input type="number" step="0.01" min="0" name="MaxTutar" value="@Model.Filtre.MaxTutar"/></label></div><footer><a asp-action="Index" class="ikincil-dugme">Temizle</a><button class="ana-dugme">Filtrele</button></footer></form></dialog>
<dialog id="ekle" class="yan-panel"><form asp-action="Ekle" method="post"><header><h2>Yeni Teklif Girişi</h2><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div><div class="panel-icerik"><label>Talep<select name="TalepNo" required><option value="">Talep seçin</option>@foreach(var t in Model.Talepler){<option value="@t.TalepNo" selected="@(t.TalepNo==Model.Form.TalepNo)">@t.TalepNo — @t.UrunAdi</option>}</select></label><label>Tedarikçi<select name="FirmaAdi" required><option value="">Tedarikçi seçin</option>@foreach(var t in Model.Tedarikciler){<option value="@t.FirmaAdi" selected="@(t.FirmaAdi==Model.Form.FirmaAdi)">@t.FirmaAdi</option>}</select></label><div class="iki-sutun"><label>Birim Fiyat<input name="Tutar" value="@(Model.Form.Tutar==0?null:Model.Form.Tutar.ToString(System.Globalization.CultureInfo.InvariantCulture))" type="number" min="0.01" step="0.01" required/></label>@ParaBirimi()</div><label>Teslim Süresi (Gün)<input name="TeslimSuresiGun" value="@(Model.Form.TeslimSuresiGun==0?null:Model.Form.TeslimSuresiGun)" type="number" min="1" required/></label><div class="iki-sutun">@Tarihler()</div></div><p class="panel-bilgi">ⓘ Teklif durumu Girildi olarak kaydedilecektir.</p><footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Teklifi Kaydet</button></footer></form></dialog>
<dialog id="duzenle" class="yan-panel"><form asp-action="Guncelle" method="post"><header><h2>Teklifi Düzenle</h2><button type="button" data-kapat>×</button></header><div class="salt-okunur"><p><span>Teklif No</span><strong>@Model.Form.TeklifNo</strong></p><p><span>Talep</span><strong>@Model.Form.TalepNo — @Model.Form.UrunAdi</strong></p><p><span>Teklif Tarihi</span><strong>@Model.Form.TeklifTarihi?.ToString("dd.MM.yyyy")</strong></p><p><span>Teklif Durumu</span><strong>@Model.Form.Durum</strong></p></div><input type="hidden" name="TeklifId" value="@Model.Form.TeklifId"/><input type="hidden" name="TeklifNo" value="@Model.Form.TeklifNo"/><input type="hidden" name="TalepNo" value="@Model.Form.TalepNo"/><div class="panel-icerik"><div class="iki-sutun"><label>Tedarikçi<select name="TedarikciId" required><option value="">Tedarikçi seçin</option>@foreach(var t in Model.Tedarikciler){<option value="@t.TedarikciId" selected="@(t.TedarikciId==Model.Form.TedarikciId)">@t.FirmaAdi</option>}</select></label><label>Teklif Tutarı<input name="Tutar" value="@Model.Form.Tutar.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0.01" step="0.01" required/></label></div><label>Teslim Süresi (Gün)<input name="TeslimSuresiGun" value="@Model.Form.TeslimSuresiGun" type="number" min="1" required/></label><div class="iki-sutun">@Tarihler()</div>@ParaBirimi()</div><footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Değişiklikleri Kaydet</button></footer></form></dialog>
@section Scripts{<script src="~/js/yonetim.js" asp-append-version="true"></script><script>yonetimBaslat('@Model.AcikPanel');</script>}
@functions{Microsoft.AspNetCore.Html.IHtmlContent ParaBirimi(){return Html.Raw($"<label>Para Birimi<select name='ParaBirimi'><option value='TRY' {(Model.Form.ParaBirimi=="TRY"?"selected":"")}>TRY</option><option value='USD' {(Model.Form.ParaBirimi=="USD"?"selected":"")}>USD</option><option value='EUR' {(Model.Form.ParaBirimi=="EUR"?"selected":"")}>EUR</option></select></label>");}Microsoft.AspNetCore.Html.IHtmlContent Tarihler(){return Html.Raw($"<label>Geçerlilik Tarihi<input type='date' name='GecerlilikTarihi' value='{Model.Form.GecerlilikTarihi:yyyy-MM-dd}' required/></label><label>SKT<input type='date' name='Skt' value='{Model.Form.Skt:yyyy-MM-dd}'/></label>");}}
