@model TeslimatTakibiViewModel
@{ViewData["Title"]="Teslimat Takibi";var uzman=int.TryParse(User.FindFirst("rol_id")?.Value,out var rolId)&&rolId==2;var bekleyen=Model.Teslimatlar.Count(x=>x.Durum=="Bekleniyor");var geciken=Model.Teslimatlar.Count(x=>x.Durum=="Gecikmiş");var tamamlanan=Model.Teslimatlar.Count(x=>x.Durum=="Tamamlandı"&&x.GercekTeslimTarihi?.Month==DateTime.Today.Month&&x.GercekTeslimTarihi?.Year==DateTime.Today.Year);}
<link rel="stylesheet" href="~/css/teslimat-takibi.css" asp-append-version="true"/>
<form method="get" class="teslimat-filtre"><input name="arama" value="@Model.Arama" placeholder="Sipariş ara..."/><select name="durum"><option value="">Tüm durumlar</option>@foreach(var d in new[]{"Bekleniyor","Gecikmiş","Tamamlandı"}){<option selected="@(Model.Durum==d)">@d</option>}</select><button>Filtrele</button></form>
@if(TempData["Basari"] is string basari){<div class="teslimat-mesaj">@basari</div>}
<section class="teslimat-ozet"><article><span>◷</span><div>Teslimat Bekleyen<strong>@bekleyen</strong></div></article><article class="gecikmis"><span>!</span><div>Geciken<strong>@geciken</strong></div></article><article><span>✓</span><div>Bu Ay Tamamlanan<strong>@tamamlanan</strong></div></article></section>
<section class="teslimat-kart"><h2>Sipariş Teslimatları</h2><div class="teslimat-tablo"><table><thead><tr><th>Sipariş No</th><th>Talep No</th><th>Ürün Adı</th><th>Tedarikçi</th><th>Sipariş Miktarı</th><th>Beklenen Teslim Tarihi</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>@foreach(var s in Model.Teslimatlar){<tr><td>@s.SiparisNo</td><td>@s.TalepNo</td><td>@s.UrunAdi</td><td>@s.Tedarikci</td><td>@s.SiparisMiktari.ToString("N2") @s.Birim</td><td>@s.BeklenenTeslimTarihi.ToString("dd.MM.yyyy")</td><td><span class="teslimat-durum @s.Durum.ToLower(new System.Globalization.CultureInfo("tr-TR"))">@s.Durum</span></td><td>@if(s.Durum!="Tamamlandı"&&uzman){<a asp-action="Index" asp-route-siparisId="@s.SiparisId">Teslimatı Kaydet</a>}else if(s.Durum=="Tamamlandı"){<span>@s.GercekTeslimTarihi?.ToString("dd.MM.yyyy")</span>}</td></tr>}@if(Model.Teslimatlar.Count==0){<tr><td colspan="8">Sipariş bulunamadı.</td></tr>}</tbody></table></div></section>
@if(Model.SeciliSiparis is{} secili){<div class="teslimat-perde"></div><aside class="teslimat-panel"><a asp-action="Index" class="kapat">×</a><h2>Teslimatı Kaydet</h2><p>@secili.SiparisNo numaralı sipariş</p><h3>Sipariş Bilgileri</h3><dl><dt>Sipariş No:</dt><dd>@secili.SiparisNo</dd><dt>Ürün Adı:</dt><dd>@secili.UrunAdi</dd><dt>Tedarikçi:</dt><dd>@secili.Tedarikci</dd><dt>Sipariş Edilen Miktar:</dt><dd>@secili.SiparisMiktari.ToString("N2") @secili.Birim</dd><dt>Beklenen Teslim Tarihi:</dt><dd>@secili.BeklenenTeslimTarihi.ToString("dd.MM.yyyy")</dd></dl><form asp-action="Kaydet" method="post"><div asp-validation-summary="ModelOnly" class="hata"></div><input asp-for="Form.SiparisId" name="SiparisId" type="hidden"/><label>Gerçek Teslim Tarihi<input asp-for="Form.GercekTeslimTarihi" name="GercekTeslimTarihi" type="date"/></label><label>Teslim Edilen Miktar<input asp-for="Form.TeslimEdilenMiktar" name="TeslimEdilenMiktar" type="number" step="0.01" max="@secili.SiparisMiktari"/></label><label>Kusurlu (Defect) Miktarı<input asp-for="Form.KusurluMiktar" name="KusurluMiktar" type="number" step="0.01"/></label><div class="panel-islem"><a asp-action="Index">Vazgeç</a><button>Teslimatı Kaydet</button></div></form></aside>}
