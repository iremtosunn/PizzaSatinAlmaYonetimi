@model AyarlarViewModel
@{ViewData["Title"]="Ayarlar";}
<link rel="stylesheet" href="~/css/bildirim-ayar.css" asp-append-version="true"/>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<div class="ayar-izgara"><section><h2>Profil Bilgileri</h2><p>Kişisel bilgilerinizi güncelleyin.</p><form asp-action="ProfilGuncelle" method="post"><div asp-validation-summary="ModelOnly" class="form-hata"></div><label>Ad Soyad<input asp-for="Profil.AdSoyad"/></label><span asp-validation-for="Profil.AdSoyad"></span><label>E-posta<input asp-for="Profil.Eposta"/></label><span asp-validation-for="Profil.Eposta"></span><label>Kullanıcı Adı<input asp-for="Profil.KullaniciAdi" readonly/></label><label>Rol<input asp-for="Profil.RolAdi" readonly/></label><footer><button>Bilgileri Güncelle</button></footer></form></section><section><h2>Şifre Değiştir</h2><p>Hesabınız için yeni bir şifre belirleyin.</p><form asp-action="SifreGuncelle" method="post"><div asp-validation-summary="ModelOnly" class="form-hata"></div><label>Mevcut Şifre<input asp-for="Sifre.MevcutSifre" autocomplete="current-password"/></label><span asp-validation-for="Sifre.MevcutSifre"></span><label>Yeni Şifre<input asp-for="Sifre.YeniSifre" autocomplete="new-password"/></label><span asp-validation-for="Sifre.YeniSifre"></span><label>Yeni Şifre Tekrar<input asp-for="Sifre.YeniSifreTekrar" autocomplete="new-password"/></label><span asp-validation-for="Sifre.YeniSifreTekrar"></span><footer><button>Şifreyi Güncelle</button></footer></form></section></div><aside class="guvenlik-notu"><span>◆</span> Şifre bilgileriniz güvenli biçimde saklanır.</aside>
