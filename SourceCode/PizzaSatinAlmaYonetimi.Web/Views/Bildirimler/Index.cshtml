@model BildirimViewModel
@{ViewData["Title"]="Bildirimler";}
<link rel="stylesheet" href="~/css/bildirim-ayar.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/bildirim-islemleri.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/bildirim-hedef.css" asp-append-version="true"/>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<section class="bildirim-ozet"><article><span>◆</span><div><small>Toplam Bildirim</small><strong>@Model.Bildirimler.Count</strong></div></article><article><span>✉</span><div><small>Okunmamış</small><strong>@Model.OkunmamisSayisi</strong></div></article><article><span>✓</span><div><small>Okundu</small><strong>@Model.OkunmusSayisi</strong></div></article><div class="bildirim-toplu-islemler"><form asp-action="TumunuOkunduYap" method="post"><button disabled="@(Model.OkunmamisSayisi==0)">Tümünü Okundu Yap</button></form><form asp-action="TumunuOkunmadiYap" method="post"><button disabled="@(Model.OkunmusSayisi==0)">Tümünü Okunmadı Yap</button></form></div></section>
<section class="bildirim-listesi"><h2>Bildirim Listesi</h2><div class="bildirim-tablo"><table><thead><tr><th>Başlık</th><th>Mesaj</th><th>Okunma Durumu</th><th>Oluşturma Tarihi</th><th>Okunma Tarihi</th><th>İşlem</th></tr></thead><tbody>@foreach(var b in Model.Bildirimler){<tr class="@(b.OkunmaDurumu=="Okunmadı"?"okunmadi":"")"><td>@if(!string.IsNullOrWhiteSpace(b.HedefUrl)){<a class="bildirim-hedef" href="@b.HedefUrl">@b.Baslik <span>→</span></a>}else{@b.Baslik}</td><td>@b.Mesaj</td><td><span class="okunma @b.OkunmaDurumu.ToLower(new System.Globalization.CultureInfo("tr-TR"))">@b.OkunmaDurumu</span></td><td>@b.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td><td>@(b.OkunmaTarihi?.ToString("dd.MM.yyyy HH:mm")??"—")</td><td><form asp-action="@(b.OkunmaDurumu=="Okunmadı"?"OkunduYap":"OkunmadiYap")" method="post"><input type="hidden" name="bildirimId" value="@b.BildirimId"/><button class="bildirim-islem">@(b.OkunmaDurumu=="Okunmadı"?"Okundu İşaretle":"Okunmadı İşaretle")</button></form></td></tr>}@if(Model.Bildirimler.Count==0){<tr><td colspan="6">Bildiriminiz bulunmuyor.</td></tr>}</tbody></table></div></section>
