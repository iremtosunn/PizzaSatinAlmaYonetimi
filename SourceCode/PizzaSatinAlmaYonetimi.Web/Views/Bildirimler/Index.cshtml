@model BildirimViewModel
@{ViewData["Title"]="Bildirimler";}
<link rel="stylesheet" href="~/css/bildirim-ayar.css" asp-append-version="true"/>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<section class="bildirim-ozet"><article><span>♢</span><div><small>Toplam Bildirim</small><strong>@Model.Bildirimler.Count</strong></div></article><article><span>✉</span><div><small>Okunmamış</small><strong>@Model.OkunmamisSayisi</strong></div></article><article><span>✓</span><div><small>Okundu</small><strong>@Model.OkunmusSayisi</strong></div></article><form asp-action="TumunuOkunduYap" method="post"><button disabled="@(Model.OkunmamisSayisi==0)">Tümünü Okundu Yap</button></form></section>
<section class="bildirim-listesi"><h2>Bildirim Listesi</h2><div class="bildirim-tablo"><table><thead><tr><th>Başlık</th><th>Mesaj</th><th>Okunma Durumu</th><th>Oluşturma Tarihi</th><th>Okunma Tarihi</th><th>İşlem</th></tr></thead><tbody>@foreach(var b in Model.Bildirimler){<tr class="@(b.OkunmaDurumu=="Okunmadı"?"okunmadi":"")"><td>@b.Baslik</td><td>@b.Mesaj</td><td><span class="okunma @b.OkunmaDurumu.ToLower(new System.Globalization.CultureInfo("tr-TR"))">@b.OkunmaDurumu</span></td><td>@b.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td><td>@(b.OkunmaTarihi?.ToString("dd.MM.yyyy HH:mm")??"—")</td><td>@if(b.OkunmaDurumu=="Okunmadı"){<form asp-action="OkunduYap" method="post"><input type="hidden" name="bildirimId" value="@b.BildirimId"/><button>Okundu Yap</button></form>}else{<span>—</span>}</td></tr>}@if(Model.Bildirimler.Count==0){<tr><td colspan="6">Bildiriminiz bulunmuyor.</td></tr>}</tbody></table></div></section>
