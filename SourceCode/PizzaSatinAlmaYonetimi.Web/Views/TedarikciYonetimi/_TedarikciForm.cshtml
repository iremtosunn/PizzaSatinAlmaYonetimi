@model TedarikciFormModel
@{var duzenleme=(bool)(ViewData["Duzenleme"]??false);}
<div class="panel-icerik">@if(duzenleme){<input type="hidden" name="TedarikciId" value="@Model.TedarikciId"/>}<label>Firma Adı<input name="FirmaAdi" value="@Model.FirmaAdi" maxlength="150" required placeholder="Firma adını girin"/></label><label>Vergi No<input name="VergiNo" value="@Model.VergiNo" maxlength="20" required placeholder="Vergi numarasını girin"/></label><label>Telefon<input name="Telefon" value="@Model.Telefon" maxlength="30" placeholder="Telefon numarasını girin"/></label><label>E-posta<input name="Eposta" value="@Model.Eposta" type="email" maxlength="150" placeholder="E-posta adresini girin"/></label><label>Adres<textarea name="Adres" maxlength="500" placeholder="Adres bilgisini girin">@Model.Adres</textarea></label></div>
