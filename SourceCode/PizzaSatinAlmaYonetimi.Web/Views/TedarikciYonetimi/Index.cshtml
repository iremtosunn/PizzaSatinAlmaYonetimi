@model TedarikciYonetimiViewModel
@{ViewData["Title"]="Tedarikçi Yönetimi";}
<link rel="stylesheet" href="~/css/yonetim.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/tedarikci.css" asp-append-version="true"/>
<div class="yonetim-ust"><form method="get" class="hizli-arama"><input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Tedarikçi ara..."/><button>⌕</button></form><button class="ikincil-dugme" type="button" data-ac="filtre">▽ Filtrele</button><button class="ana-dugme" type="button" data-ac="ekle">＋ Yeni Tedarikçi</button></div>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<section class="tablo-karti"><h2>Tedarikçi Listesi</h2><div class="tablo-sarma"><table><thead><tr><th>Tedarikçi ID</th><th>Firma Adı</th><th>Vergi No</th><th>Telefon</th><th>E-posta</th><th>Adres</th><th>Durum</th><th>Kayıt Tarihi</th><th>İşlemler</th></tr></thead><tbody>@foreach(var t in Model.Tedarikciler){<tr><td>@t.TedarikciId</td><td>@t.FirmaAdi</td><td>@t.VergiNo</td><td>@(t.Telefon??"—")</td><td>@(t.Eposta??"—")</td><td class="adres">@(t.Adres??"—")</td><td><span class="durum @(t.Durum=="Aktif"?"aktif":"pasif")">@t.Durum</span></td><td>@t.KayitTarihi.ToString("dd.MM.yyyy")</td><td class="islemler"><a asp-action="Index" asp-route-panel="duzenle" asp-route-duzenleId="@t.TedarikciId" title="Düzenle">✎</a><form asp-action="DurumGuncelle" method="post"><input type="hidden" name="tedarikciId" value="@t.TedarikciId"/><input type="hidden" name="yeniDurum" value="@(t.Durum=="Aktif"?0:1)"/><button title="@(t.Durum=="Aktif"?"Pasif yap":"Aktif yap")">⏻</button></form></td></tr>}@if(Model.Tedarikciler.Count==0){<tr><td colspan="9" class="bos">Kriterlere uygun tedarikçi bulunamadı.</td></tr>}</tbody></table></div><p class="kayit-sayisi">@Model.Tedarikciler.Count tedarikçi</p></section>
<dialog id="filtre" class="filtre-panel"><form method="get"><header><h2>Tedarikçileri Filtrele</h2><button type="button" data-kapat>×</button></header><label>Arama Metni<input name="AramaMetni" value="@Model.Filtre.AramaMetni" placeholder="Firma Adı, Vergi No, Telefon veya E-posta"/></label><label>Durum<select name="Durum"><option value="">Durum seçiniz</option><option value="1" selected="@(Model.Filtre.Durum==1)">Aktif</option><option value="0" selected="@(Model.Filtre.Durum==0)">Pasif</option></select></label><div class="iki-sutun"><label>Başlangıç Tarihi<input type="date" name="BaslangicTarihi" value="@Model.Filtre.BaslangicTarihi?.ToString("yyyy-MM-dd")"/></label><label>Bitiş Tarihi<input type="date" name="BitisTarihi" value="@Model.Filtre.BitisTarihi?.ToString("yyyy-MM-dd")"/></label></div><footer><a asp-action="Index" class="ikincil-dugme">Temizle</a><button class="ana-dugme">Filtrele</button></footer></form></dialog>
<dialog id="ekle" class="yan-panel"><form asp-action="Ekle" method="post"><header><h2>Yeni Tedarikçi</h2><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div>@await Html.PartialAsync("_TedarikciForm",Model.Form,new ViewDataDictionary(ViewData){["Duzenleme"]=false})<p class="panel-bilgi">ⓘ Tedarikçi durumu Aktif olarak kaydedilecektir.</p><footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Tedarikçiyi Kaydet</button></footer></form></dialog>
<dialog id="duzenle" class="yan-panel"><form asp-action="Guncelle" method="post"><header><h2>Tedarikçiyi Düzenle</h2><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div>@await Html.PartialAsync("_TedarikciForm",Model.Form,new ViewDataDictionary(ViewData){["Duzenleme"]=true})<footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Değişiklikleri Kaydet</button></footer></form></dialog>
@section Scripts{<script src="~/js/yonetim.js" asp-append-version="true"></script><script>yonetimBaslat('@Model.AcikPanel');</script>}
