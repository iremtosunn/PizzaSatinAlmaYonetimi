@model TeklifKarsilastirmaViewModel
@{ViewData["Title"]="Teklif Karşılaştırma";}
<link rel="stylesheet" href="~/css/karsilastirma-onay.css" asp-append-version="true"/>
<form method="get" class="talep-arama"><input name="talepNo" value="@Model.TalepNo" placeholder="Talep No Giriniz"/><button>Ara</button></form>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
@if(Model.Talep is not null){<section class="bilgi-karti"><h2>Talep Bilgileri</h2><div><p><strong>Talep No:</strong><span>@Model.Talep.TalepNo</span></p><p><strong>Ürün Adı:</strong><span>@Model.Talep.UrunAdi</span></p><p><strong>Miktar:</strong><span>@Model.Talep.Miktar.ToString("N2") @Model.Talep.Birim</span></p><p><strong>Talep Eden:</strong><span>@Model.Talep.TalepEden</span></p></div></section><section class="teklif-alani"><header><h2>Talebe Ait Teklifler</h2><span>@Model.Teklifler.Count teklif gösteriliyor</span></header><div class="teklif-kartlari">@foreach(var t in Model.Teklifler){<article><dl><dt>Teklif No</dt><dd>@t.TeklifNo</dd><dt>Tedarikçi</dt><dd>@t.FirmaAdi</dd><dt>Teklif Tutarı</dt><dd>@t.TeklifTutari.ToString("N2") @t.ParaBirimi</dd><dt>Teslim Süresi</dt><dd>@t.TeslimSuresiGun gün</dd><dt>SKT</dt><dd>@(t.Skt?.ToString("dd.MM.yyyy")??"—")</dd><dt>Geçerlilik Tarihi</dt><dd>@(t.GecerlilikTarihi?.ToString("dd.MM.yyyy")??"—")</dd><dt>Durum</dt><dd><span class="durum-rozet @t.Durum.ToLower(new System.Globalization.CultureInfo("tr-TR"))">@t.Durum</span></dd></dl>@if(t.Durum=="Girildi"){<div class="kart-islemleri"><form asp-action="Sec" method="post" onsubmit="return confirm('Bu teklifi seçmek istediğinize emin misiniz? Aynı talebe ait diğer teklifler reddedilecektir.');"><input type="hidden" name="talepNo" value="@t.TalepNo"/><input type="hidden" name="teklifNo" value="@t.TeklifNo"/><button class="sec">Teklifi Seç</button></form><form asp-action="Reddet" method="post" onsubmit="return confirm('Bu teklifi reddetmek istediğinize emin misiniz?');"><input type="hidden" name="talepNo" value="@t.TalepNo"/><input type="hidden" name="teklifNo" value="@t.TeklifNo"/><button class="reddet">Teklifi Reddet</button></form></div>}</article>}@if(Model.Teklifler.Count==0){<p>Bu talebe ait teklif bulunamadı.</p>}</div></section>}else if(!string.IsNullOrWhiteSpace(Model.TalepNo)){<section class="bilgi-karti bos">Belirtilen talep bulunamadı.</section>}
