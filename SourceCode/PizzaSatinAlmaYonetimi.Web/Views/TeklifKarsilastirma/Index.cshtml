@model TeklifKarsilastirmaViewModel
@{ViewData["Title"]="Teklif Karşılaştırma";var yonetici=int.TryParse(User.FindFirst("rol_id")?.Value,out var rolId)&&rolId==1;}
<link rel="stylesheet" href="~/css/karsilastirma-onay.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/tedarikci-puani.css" asp-append-version="true"/>
<form method="get" class="talep-arama"><select name="talepNo" required><option value="">Talep seçiniz</option>@foreach(var s in Model.Talepler){<option value="@s.TalepNo" selected="@(s.TalepNo==Model.TalepNo)">@s.TalepNo - @s.UrunAdi</option>}</select><button>Göster</button></form>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>}@if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
@if(Model.Talep is not null){<section class="bilgi-karti"><h2>Talep Bilgileri</h2><div><p><strong>Talep No:</strong><span>@Model.Talep.TalepNo</span></p><p><strong>Ürün Adı:</strong><span>@Model.Talep.UrunAdi</span></p><p><strong>Miktar:</strong><span>@Model.Talep.Miktar.ToString("N2") @Model.Talep.Birim</span></p><p><strong>Talep Eden:</strong><span>@Model.Talep.TalepEden</span></p>@if(yonetici){<p><strong>Uzman Görüşü:</strong><span>@(Model.Talep.ErtelenebilirMi==false?"Öncelikli":Model.Talep.ErtelenebilirMi==true?"Ertelenebilir":"Değerlendirilmedi")</span></p>}</div></section>
<section class="teklif-alani"><header><h2>Talebe Ait Teklifler</h2><span>@Model.Teklifler.Count teklif gösteriliyor</span></header><div class="teklif-kartlari">@foreach(var t in Model.Teklifler){var puanSinifi=!t.TedarikciPuani.HasValue?"yok":t.TedarikciPuani>=80?"yuksek":t.TedarikciPuani>=60?"orta":"dusuk";<article><dl><dt>Teklif No</dt><dd>@t.TeklifNo</dd><dt>Tedarikçi</dt><dd>@t.FirmaAdi</dd><dt>Tedarikçi Puanı</dt><dd><span class="tedarikci-puani @puanSinifi" title="@t.TamamlananTeslimat tamamlanmış teslimat">@(t.TedarikciPuani.HasValue?$"★ {t.TedarikciPuani:N1}/100":"Henüz puan yok")</span></dd><dt>Teklif Tutarı</dt><dd>@t.TeklifTutari.ToString("N2") @t.ParaBirimi</dd><dt>Teslim Süresi</dt><dd>@t.TeslimSuresiGun gün</dd><dt>SKT</dt><dd>@(t.Skt?.ToString("dd.MM.yyyy")??"—")</dd><dt>Geçerlilik Tarihi</dt><dd>@(t.GecerlilikTarihi?.ToString("dd.MM.yyyy")??"—")</dd><dt>Durum</dt><dd><span class="durum-rozet @t.Durum.ToLower(new System.Globalization.CultureInfo("tr-TR"))">@t.Durum</span></dd></dl>@if(t.Durum=="Girildi"){<div class="kart-islemleri"><form asp-action="Sec" method="post"><input type="hidden" name="talepNo" value="@t.TalepNo"/><input type="hidden" name="teklifNo" value="@t.TeklifNo"/><button class="sec">Teklifi Seç</button></form><form asp-action="Reddet" method="post"><input type="hidden" name="talepNo" value="@t.TalepNo"/><input type="hidden" name="teklifNo" value="@t.TeklifNo"/><button class="reddet">Teklifi Reddet</button></form></div>}else if(yonetici&&t.Durum=="Reddedildi"){<div class="kart-islemleri"><form asp-action="GeriAl" method="post"><input type="hidden" name="talepNo" value="@t.TalepNo"/><input type="hidden" name="teklifNo" value="@t.TeklifNo"/><button class="sec">Geri Al</button></form></div>}</article>}@if(Model.Teklifler.Count==0){<p>Bu talebe ait teklif bulunamadı.</p>}</div></section>}else if(!string.IsNullOrWhiteSpace(Model.TalepNo)){<section class="bilgi-karti bos">Belirtilen talep bulunamadı.</section>}
