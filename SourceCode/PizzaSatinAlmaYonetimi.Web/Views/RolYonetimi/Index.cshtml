@model RolYonetimiViewModel
@{ViewData["Title"]="Rol Yönetimi";var secili=Model.Roller.FirstOrDefault(x=>x.RolId==Model.SeciliRolId);}
<link rel="stylesheet" href="~/css/yonetim.css" asp-append-version="true"/>
<div class="yonetim-ust"><form method="get" class="hizli-arama"><input name="aramaMetni" value="@Model.AramaMetni" placeholder="Rol ara..."/><button>⌕</button></form><button class="ana-dugme" type="button" data-ac="rol-ekle">＋ Yeni Rol</button></div>
@if(TempData["Basari"] is string basari){<div class="bildiri basari">@basari</div>} @if(TempData["Hata"] is string hata){<div class="bildiri hata">@hata</div>}
<div class="rol-izgara"><section class="tablo-karti"><h2>Rol Listesi</h2><div class="tablo-sarma"><table><thead><tr><th>Rol ID</th><th>Rol Adı</th><th>Açıklama</th><th>Kullanıcı Sayısı</th><th>İşlemler</th></tr></thead><tbody>@foreach(var r in Model.Roller){<tr class="@(r.RolId==Model.SeciliRolId?"secili-satir":"")"><td>@r.RolId</td><td><a asp-action="Index" asp-route-rolId="@r.RolId">@r.RolAdi</a></td><td>@r.Aciklama</td><td>@r.KullaniciSayisi</td><td><a asp-action="Index" asp-route-rolId="@r.RolId" asp-route-panel="duzenle" title="Düzenle">✎</a></td></tr>}</tbody></table></div><p class="kayit-sayisi">@Model.Roller.Count rol</p></section>
<section class="tablo-karti yetki-karti"><h2>Rol Yetkileri</h2>@if(secili is null){<p class="bos">Yetkilerini görüntülemek için bir rol seçin.</p>}else{<div class="secili-rol">@secili.RolAdi</div><form asp-action="YetkileriGuncelle" method="post"><input type="hidden" name="RolId" value="@secili.RolId"/><div class="yetki-listesi">@foreach(var y in Model.Yetkiler){<label><input type="checkbox" name="YetkiIdleri" value="@y.YetkiId" checked="@y.SeciliMi"/><span><strong>@y.YetkiAdi</strong><small>@y.YetkiKodu</small></span></label>}</div><div class="yetki-footer"><button class="ana-dugme">Yetkileri Kaydet</button></div></form>}</section></div>
<dialog id="rol-ekle" class="orta-panel"><form asp-action="Ekle" method="post"><header><h2>Yeni Rol Ekle</h2><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div><div class="panel-icerik"><label>Rol Adı<input name="RolAdi" value="@Model.Form.RolAdi" maxlength="100" required placeholder="Rol adı giriniz"/></label><label>Açıklama <small>İsteğe bağlı</small><textarea name="Aciklama" maxlength="500" placeholder="Rol açıklaması giriniz">@Model.Form.Aciklama</textarea></label></div><footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Rolü Kaydet</button></footer></form></dialog>
<dialog id="duzenle" class="orta-panel"><form asp-action="Guncelle" method="post"><header><h2>Rolü Düzenle</h2><button type="button" data-kapat>×</button></header><div asp-validation-summary="ModelOnly" class="form-hata"></div><input type="hidden" name="RolId" value="@Model.Form.RolId"/><div class="panel-icerik"><label>Rol Adı<input name="RolAdi" value="@Model.Form.RolAdi" maxlength="100" required/></label><label>Açıklama<textarea name="Aciklama" maxlength="500">@Model.Form.Aciklama</textarea></label></div><footer><button type="button" class="ikincil-dugme" data-kapat>İptal</button><button class="ana-dugme">Değişiklikleri Kaydet</button></footer></form></dialog>
@section Scripts{<script src="~/js/yonetim.js" asp-append-version="true"></script><script>yonetimBaslat('@(Model.AcikPanel=="ekle"?"rol-ekle":Model.AcikPanel)');</script>}
